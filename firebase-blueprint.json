{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user-specific information and settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier for the user." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "photoURL": { "type": "string", "description": "The user's profile photo URL." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." }
      },
      "required": ["uid", "email"]
    },
    "HistoryItem": {
      "title": "History Item",
      "description": "Stores a record of a hijab modification.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user ID who created this item." },
        "originalImageUrl": { "type": "string", "description": "URL of the original uploaded image." },
        "modifiedImageUrl": { "type": "string", "description": "URL of the AI-modified image." },
        "style": { "type": "string", "enum": ["realistic", "2d", "3d"], "description": "Detected style of the image." },
        "hijabType": { "type": "string", "enum": ["pashmina", "segiempat", "syari", "turban"], "description": "Type of hijab applied." },
        "hijabColor": { "type": "string", "description": "Hex code of the hijab color." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the modification was performed." }
      },
      "required": ["uid", "originalImageUrl", "modifiedImageUrl", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles."
    },
    "history/{historyId}": {
      "schema": "HistoryItem",
      "description": "Collection of modification history records."
    }
  }
}
